# Same-origin via Next rewrite (recommended — refresh cookie works with SameSite=Lax)
NEXT_PUBLIC_API_URL=/api/v1

# Upstream Nest API for next.config.ts rewrites
API_PROXY_TARGET=http://localhost:3001

# Alternative: call API directly (cross-origin). Then set API REFRESH_COOKIE_SAME_SITE=none
# and REFRESH_COOKIE_SECURE=true in production.
# NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Cloudinary (avatar upload — copy vào apps/web/.env)
# Dashboard → Settings → Product environment credentials + Upload presets (unsigned)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
